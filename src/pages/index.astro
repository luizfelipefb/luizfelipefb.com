---
// Skills grouped by the problem they solve.
const skills = [
  {
    name: 'Cloud & platform',
    about: 'Where everything runs: multi-account clouds and Kubernetes, provisioned as code.',
    skills: ['aws', 'kubernetes', 'eks', 'terraform', 'gcp', 'azure', 'istio', 'security'],
  },
  {
    name: 'Delivery',
    about: 'Getting changes to production often and safely, with little manual work.',
    skills: ['devops', 'ci/cd', 'jenkins', 'argocd', 'gitops', 'drone ci'],
  },
  {
    name: 'Reliability & observability',
    about: 'Knowing something is wrong before users do, and fixing it fast.',
    skills: ['sre', 'new relic', 'cloudwatch', 'datadog', 'opentelemetry', 'grafana'],
  },
  {
    name: 'Architecture & data',
    about: 'How services talk to each other, and where their state lives.',
    skills: ['microservices', 'apis', 'postgresql', 'kafka', 'aurora', 'mongodb', 'redis'],
  },
  {
    name: 'AI',
    about: 'Agents and LLMs in my daily workflow, used with review and guardrails.',
    skills: ['claude code', 'mcp', 'agents', 'llms', 'prompt engineering'],
  },
  {
    name: 'Code',
    about: 'What I write the tooling, services and interfaces in.',
    skills: [
      'python', 'node.js', 'java', 'groovy', 'react', 'astro', 'bash',
      'javascript', 'c#', 'go', 'vue', 'redux', 'angularjs',
    ],
  },
  {
    name: 'Homeserver',
    href: 'https://github.com/luizfelipefb/homeserver',
    about: 'My own servers at home, for learning and fun.',
    skills: [
      'docker', 'traefik', 'cloudflare tunnel', 'adguard', 'networking', 'vpn', 'nas',
      'home assistant', 'node-red', 'influxdb', 'telegraf', 'backrest', 'automation',
      'plex', 'jellyfin',
    ],
  },
];

const links = [
  { label: 'github', href: 'https://github.com/luizfelipefb' },
  { label: 'linkedin', href: 'https://linkedin.com/in/luizfelipefb' },
  { label: 'instagram', href: 'https://instagram.com/luizfelipefb' },
  { label: 'email', href: 'mailto:luizfelipefb@gmail.com' },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Luiz Felipe Fontes Botelho | pin</title>
    <meta
      name="description"
      content="Luiz Felipe Fontes Botelho (pin): DevOps engineer from Brazil. Cloud, infrastructure and software."
    />
    <meta name="theme-color" content="#0E1116" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap"
    />
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>

  <body>
    <button id="theme" type="button" aria-label="Switch to light mode" hidden>light mode</button>

    <main>
      <p class="line cmd" style="--d:.1s;--t:.4s;--n:6">
        <span class="ps">luizfelipefb:~$</span> <span class="typed">whoami</span>
      </p>
      <div class="out" style="--o:.55s">
        <h1>Luiz Felipe Fontes Botelho</h1>
        <p class="role">pin, devops and software engineer</p>
      </div>

      <p class="line cmd" style="--d:.9s;--t:.5s;--n:12">
        <span class="ps">luizfelipefb:~$</span> <span class="typed">cat about.md</span>
      </p>
      <p class="out about" style="--o:1.4s">
        I build and run cloud infrastructure and software, and I’ve been writing software since 2008. I like
        problems I don’t know how to solve <em>yet</em>, because that’s where I learn the most. Away from the
        keyboard it’s health, fitness, nutrition and just about any sport. So, how can I help?
      </p>

      <p class="line cmd" style="--d:1.8s;--t:.45s;--n:10">
        <span class="ps">luizfelipefb:~$</span> <span class="typed">ls skills/</span>
      </p>
      <div class="out skills" style="--o:2.3s">
        {skills.map((group) => (
          <section class="group">
            <div>
              <h2>
                {group.href ? (
                  <a href={group.href} rel="noopener" target="_blank">{group.name}</a>
                ) : (
                  group.name
                )}
              </h2>
              <p class="group-about">{group.about}</p>
            </div>
            <p class="group-skills">
              {group.skills.map((name, i) => (
                <>
                  <span class="sk">{name}</span>
                  {i < group.skills.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
          </section>
        ))}
      </div>

      <p class="line cmd" style="--d:2.7s;--t:.5s;--n:13">
        <span class="ps">luizfelipefb:~$</span> <span class="typed">cat links.txt</span>
      </p>
      <ul class="out links" style="--o:3.2s">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              rel="noopener"
              target={link.href.startsWith('http') ? '_blank' : undefined}
            >{link.label}</a>
          </li>
        ))}
      </ul>

      <p class="line prompt" style="--d:3.5s" aria-hidden="true">
        <span class="ps">luizfelipefb:~$</span> <span class="cursor" aria-hidden="true"></span>
      </p>
    </main>

    <footer><a href="https://en.wikipedia.org/wiki/Pi" rel="noopener" target="_blank">π</a>n</footer>

    <script is:inline>
      (function () {
        var button = document.getElementById('theme');
        var root = document.documentElement;
        function current() {
          return root.dataset.theme === 'light' ? 'light' : 'dark';
        }
        function paint() {
          var isLight = current() === 'light';
          button.textContent = isLight ? 'dark mode' : 'light mode';
          button.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
          document
            .querySelector('meta[name="theme-color"]')
            .setAttribute('content', isLight ? '#F6F8FA' : '#0E1116');
        }
        button.addEventListener('click', function () {
          var next = current() === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          paint();
        });
        paint();
        button.hidden = false;
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0e1116;
    --fg: #e6edf3;
    --muted: #8b98a5;
    --accent: #3ddc97;
    --rule: #232a33;
    color-scheme: dark;

    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  :root[data-theme='light'] {
    --bg: #f6f8fa;
    --fg: #1f2328;
    --muted: #5b6672;
    --accent: #0b7a4b;
    --rule: #d8dee4;
    color-scheme: light;
  }

  html {
    scroll-padding-top: env(safe-area-inset-top, 0px);
    -webkit-text-size-adjust: 100%;
  }

  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono',
      monospace;
    font-size: 0.9375rem;
    line-height: 1.65;
    transition: background 0.2s ease, color 0.2s ease;
  }

  main {
    max-width: 64rem;
    min-height: calc(100svh - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px) - 3rem);
    margin: 0 auto;
    padding: 4rem max(1.25rem, env(safe-area-inset-right, 0px)) 1rem
      max(1.25rem, env(safe-area-inset-left, 0px));
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  p {
    margin: 0;
  }

  .ps {
    color: var(--accent);
    font-weight: 700;
  }

  /* One orchestrated moment: the session types itself in once on load. */
  .line {
    margin-top: 2rem;
    opacity: 0;
    animation: show 0.01s linear var(--d) forwards;
  }

  main > .line:first-child {
    margin-top: 0;
  }

  /* Revealed by clipping a percentage of its own box, not by a width in ch units. The ch width was
     computed with the fallback font, so a late font swap cut off the last letter on first visit. */
  .typed {
    display: inline-block;
    white-space: nowrap;
    vertical-align: bottom;
    clip-path: inset(0 100% 0 0);
    animation: type var(--t) steps(var(--n)) var(--d) forwards;
  }

  .out {
    margin-top: 0.5rem;
    opacity: 0;
    animation: show 0.01s linear var(--o) forwards;
  }

  @keyframes type {
    to {
      clip-path: inset(0);
    }
  }

  @keyframes show {
    to {
      opacity: 1;
    }
  }

  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 7.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .role {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  /* Emphasis in the bio. The font has no italic, so use the accent color and weight instead. */
  em {
    color: var(--accent);
    font-style: normal;
    font-weight: 700;
  }

  /* Skills: title and one-line description on the left, skills on the right. */
  .group {
    display: grid;
    grid-template-columns: 20rem 1fr;
    gap: 0.5rem 2rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }

  .group:last-child {
    padding-bottom: 0;
  }

  .group h2 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }

  /* A linked title looks like the others; the muted underline and arrow mark it as a link. */
  .group h2 a {
    color: inherit;
    text-decoration-color: var(--muted);
  }

  .group h2 a::after {
    content: ' ↗' / '';
    color: var(--muted);
    font-weight: 400;
  }

  .group h2 a:hover,
  .group h2 a:focus-visible {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .group h2 a:hover::after,
  .group h2 a:focus-visible::after {
    color: var(--accent);
  }

  .group-about {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  /* Keep multi-word skills like "new relic" on one line. */
  .sk {
    white-space: nowrap;
  }

  /* Too narrow for two columns: stack the description above the skills. */
  @media (max-width: 48rem) {
    .group {
      grid-template-columns: 1fr;
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Absolute, not fixed: on short screens a fixed button sits on top of the text as it scrolls. */
  #theme {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 0.75rem);
    right: max(1rem, env(safe-area-inset-right, 0px));
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--muted);
    border-radius: 4px;
    background: var(--bg);
    color: var(--muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  #theme:hover {
    color: var(--fg);
    border-color: var(--fg);
  }

  footer {
    padding: 0 max(1.25rem, env(safe-area-inset-right, 0px)) 1.5rem
      max(1.25rem, env(safe-area-inset-left, 0px));
    max-width: 64rem;
    margin: 0 auto;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  footer a {
    color: inherit;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .line,
    .out {
      opacity: 1;
      animation: none;
    }

    .typed {
      clip-path: none;
      animation: none;
    }

    .cursor {
      animation: none;
    }

    body {
      transition: none;
    }
  }
</style>
